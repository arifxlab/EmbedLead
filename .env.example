# ============================================================
# EmbedLead Environment Configuration
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to Git.
# ============================================================

APP_NAME=EmbedLead
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://embedlead:embedlead@localhost:5432/embedlead

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_PER_MINUTE=60

GEO_PRIMARY_URL=https://ipapi.co
GEO_FALLBACK_URL=https://ipwho.is

WIDGET_CACHE_TTL_SECONDS=300

MAX_SUBMISSION_PAYLOAD_BYTES=16384

# Replace this with a cryptographically secure value outside development.
SECRET_KEY=development-only-change-me
